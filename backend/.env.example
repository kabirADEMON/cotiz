DATABASE_URL=postgresql+psycopg://tontine:tontine@localhost:5432/tontine
# development en local ; en production, mettre APP_ENV=production et une vraie clé JWT_SECRET :
# l'API refuse de démarrer avec la valeur d'exemple ci-dessous.
APP_ENV=development
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_EXPIRE_MINUTES=1440

# FedaPay (https://sandbox-dashboard.fedapay.com > Paramètres > Clés API)
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxx
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxx

# URL du frontend (redirection après paiement + CORS)
FRONTEND_URL=http://localhost:5180
